#!/usr/bin/env bash
# OpenTUI Skill Release Management Script
# Version: 1.0.0
# Follows project-manager release patterns with manifest-first approach

set -euo pipefail

# ============================================================================
# Configuration
# ============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MANIFEST_FILE="$REPO_ROOT/INSTALLATION.yaml"
VERSION_FILE="$REPO_ROOT/VERSION"
CHANGELOG_FILE="$REPO_ROOT/CHANGELOG.md"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# ============================================================================
# Utility Functions
# ============================================================================

log_info() {
    echo -e "${BLUE}[info]${NC} $*"
}

log_success() {
    echo -e "${GREEN}[ok]${NC} $*"
}

log_warn() {
    echo -e "${YELLOW}[warn]${NC} $*"
}

log_error() {
    echo -e "${RED}[error]${NC} $*"
}

die() {
    log_error "$*"
    exit 1
}

# ============================================================================
# Version Parsing and Manipulation
# ============================================================================

parse_version() {
    local version="$1"
    # Strip leading 'v' if present
    version="${version#v}"

    if [[ ! "$version" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
        die "Invalid version format: $version (expected X.Y.Z)"
    fi

    MAJOR="${BASH_REMATCH[1]}"
    MINOR="${BASH_REMATCH[2]}"
    PATCH="${BASH_REMATCH[3]}"
}

bump_version() {
    local version="$1"
    local bump_type="$2"

    parse_version "$version"

    case "$bump_type" in
        major)
            echo "$((MAJOR + 1)).0.0"
            ;;
        minor)
            echo "$MAJOR.$((MINOR + 1)).0"
            ;;
        patch)
            echo "$MAJOR.$MINOR.$((PATCH + 1))"
            ;;
        *)
            die "Invalid bump type: $bump_type (expected major, minor, or patch)"
            ;;
    esac
}

get_current_version() {
    if [ -f "$VERSION_FILE" ]; then
        cat "$VERSION_FILE" | tr -d '\n'
    elif [ -f "$MANIFEST_FILE" ]; then
        grep "^  version:" "$MANIFEST_FILE" | sed 's/.*version: *//; s/ *#.*//' | tr -d '\n'
    else
        echo "0.0.0"
    fi
}

# ============================================================================
# Manifest Operations
# ============================================================================

update_manifest_version() {
    local new_version="$1"

    if [ ! -f "$MANIFEST_FILE" ]; then
        log_warn "INSTALLATION.yaml not found, skipping manifest update"
        return
    fi

    # Update version in manifest using sed (macOS compatible)
    if [[ "$OSTYPE" == "darwin"* ]]; then
        sed -i '' "s/^  version: .*/  version: $new_version/" "$MANIFEST_FILE"
    else
        sed -i "s/^  version: .*/  version: $new_version/" "$MANIFEST_FILE"
    fi

    log_success "Updated INSTALLATION.yaml to version $new_version"
}

# ============================================================================
# Changelog Operations
# ============================================================================

update_changelog() {
    local new_version="$1"
    local current_date
    current_date=$(date +%Y-%m-%d)

    if [ ! -f "$CHANGELOG_FILE" ]; then
        log_warn "CHANGELOG.md not found, creating new one"
        cat > "$CHANGELOG_FILE" <<EOF
# Changelog

All notable changes to this project will be documented in this file.

The format is based on [Keep a Changelog](https://keepachangelog.com/en/1.0.0/) and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0.html).

## [Unreleased]

## [$new_version] - $current_date

### Added

- Initial release

EOF
        log_success "Created CHANGELOG.md"
        return
    fi

    # Check if unreleased section exists
    if ! grep -q "## \[Unreleased\]" "$CHANGELOG_FILE"; then
        log_warn "No [Unreleased] section in CHANGELOG.md"
        return
    fi

    # Add new version section after Unreleased
    local temp_file
    temp_file=$(mktemp)

    awk -v version="$new_version" -v date="$current_date" '
        /^## \[Unreleased\]/ {
            print
            print ""
            print "## [" version "] - " date
            next
        }
        { print }
    ' "$CHANGELOG_FILE" > "$temp_file"

    mv "$temp_file" "$CHANGELOG_FILE"
    log_success "Updated CHANGELOG.md with version $new_version"
}

# ============================================================================
# Git Operations
# ============================================================================

check_git_status() {
    if ! git rev-parse --is-inside-work-tree &>/dev/null; then
        die "Not in a git repository"
    fi

    if [[ -n $(git status --porcelain) ]]; then
        log_warn "Working directory has uncommitted changes"
        git status --short
        read -p "Continue anyway? (y/N) " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            die "Aborted by user"
        fi
    fi
}

git_commit_and_tag() {
    local version="$1"
    local message="chore(release): bump version to $version"

    # Stage version-related files
    git add "$VERSION_FILE" "$MANIFEST_FILE" "$CHANGELOG_FILE"

    # Commit
    git commit -m "$message" -m "Co-Authored-By: Claude Sonnet 4.5 <noreply@anthropic.com>"
    log_success "Created commit: $message"

    # Create tag
    git tag -a "v$version" -m "Release version $version"
    log_success "Created tag: v$version"
}

git_push() {
    local push_remote="${1:-origin}"
    local push_branch="${2:-main}"

    log_info "Pushing to remote: $push_remote/$push_branch"
    git push "$push_remote" "$push_branch"
    git push "$push_remote" --tags
    log_success "Pushed commits and tags to $push_remote"
}

# ============================================================================
# Commands
# ============================================================================

cmd_bump() {
    local bump_type="${1:-}"
    local auto_push="${2:-false}"

    if [ -z "$bump_type" ]; then
        die "Usage: $0 bump <major|minor|patch> [--push]"
    fi

    if [[ "$bump_type" == "--push" ]]; then
        die "Usage: $0 bump <major|minor|patch> [--push]"
    fi

    if [[ "${2:-}" == "--push" ]]; then
        auto_push="true"
    fi

    check_git_status

    local current_version
    current_version=$(get_current_version)
    log_info "Current version: $current_version"

    local new_version
    new_version=$(bump_version "$current_version" "$bump_type")
    log_info "New version: $new_version"

    # Update files
    echo "$new_version" > "$VERSION_FILE"
    update_manifest_version "$new_version"
    update_changelog "$new_version"

    # Git commit and tag
    git_commit_and_tag "$new_version"

    log_success "Version bumped to $new_version"

    if [[ "$auto_push" == "true" ]]; then
        git_push
    else
        log_info "Run 'git push origin main --tags' to push changes"
    fi
}

cmd_status() {
    local current_version
    current_version=$(get_current_version)

    echo "Repository: opentui-skill"
    echo "Current version: $current_version"
    echo ""

    if [ -f "$VERSION_FILE" ]; then
        echo "VERSION file: $(cat "$VERSION_FILE")"
    else
        echo "VERSION file: (not found)"
    fi

    if [ -f "$MANIFEST_FILE" ]; then
        echo "INSTALLATION.yaml version: $(grep "^  version:" "$MANIFEST_FILE" | sed 's/.*version: *//')"
    else
        echo "INSTALLATION.yaml: (not found)"
    fi

    echo ""
    echo "Git status:"
    git status --short || echo "Not in a git repository"

    echo ""
    echo "Recent tags:"
    git tag --sort=-v:refname | head -5 || echo "No tags found"
}

cmd_changelog() {
    if [ ! -f "$CHANGELOG_FILE" ]; then
        die "CHANGELOG.md not found"
    fi

    cat "$CHANGELOG_FILE"
}

cmd_validate() {
    log_info "Validating release readiness..."

    local errors=0

    # Check VERSION file
    if [ ! -f "$VERSION_FILE" ]; then
        log_error "VERSION file not found"
        ((errors++))
    fi

    # Check INSTALLATION.yaml
    if [ ! -f "$MANIFEST_FILE" ]; then
        log_error "INSTALLATION.yaml not found"
        ((errors++))
    fi

    # Check CHANGELOG.md
    if [ ! -f "$CHANGELOG_FILE" ]; then
        log_error "CHANGELOG.md not found"
        ((errors++))
    fi

    # Check skill files
    if [ ! -f "$REPO_ROOT/skills/opentui-tui-development/SKILL.md" ]; then
        log_error "opentui-tui-development SKILL.md not found"
        ((errors++))
    fi

    if [ ! -f "$REPO_ROOT/skills/opentui-layout-review/SKILL.md" ]; then
        log_error "opentui-layout-review SKILL.md not found"
        ((errors++))
    fi

    # Check version consistency
    if [ -f "$VERSION_FILE" ] && [ -f "$MANIFEST_FILE" ]; then
        local version_file_version
        local manifest_version
        version_file_version=$(cat "$VERSION_FILE" | tr -d '\n')
        manifest_version=$(grep "^  version:" "$MANIFEST_FILE" | sed 's/.*version: *//; s/ *#.*//' | tr -d '\n')

        if [ "$version_file_version" != "$manifest_version" ]; then
            log_error "Version mismatch: VERSION=$version_file_version, INSTALLATION.yaml=$manifest_version"
            ((errors++))
        fi
    fi

    if [ $errors -eq 0 ]; then
        log_success "All validation checks passed"
        return 0
    else
        die "Validation failed with $errors error(s)"
    fi
}

cmd_help() {
    cat <<EOF
OpenTUI Skill Release Management

Usage: $0 <command> [options]

Commands:
  bump <type> [--push]  Bump version (major, minor, patch) and optionally push
  status                Show current version and git status
  changelog             Display CHANGELOG.md
  validate              Validate release readiness
  help                  Show this help message

Examples:
  $0 bump patch         # Bump patch version (1.0.0 -> 1.0.1)
  $0 bump minor --push  # Bump minor version and push to remote
  $0 status             # Show current status
  $0 validate           # Validate before release

EOF
}

# ============================================================================
# Main Entry Point
# ============================================================================

main() {
    local command="${1:-help}"
    shift || true

    case "$command" in
        bump)
            cmd_bump "$@"
            ;;
        status)
            cmd_status
            ;;
        changelog)
            cmd_changelog
            ;;
        validate)
            cmd_validate
            ;;
        help|--help|-h)
            cmd_help
            ;;
        *)
            log_error "Unknown command: $command"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
